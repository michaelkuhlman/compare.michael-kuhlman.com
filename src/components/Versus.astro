---
import { STACK_META } from '../lib/model';
import { ROWS, tally, WINS, PRIORITIES, journeyLine, SOURCES } from '../lib/versus';
import { avg } from '../lib/data';
const total = ROWS.length;
const edgeLabel = { shopify: 'Shopify', m2: 'Magento 2', depends: 'Depends' } as const;
const sup = (src?: number[]) => (src && src.length ? src : []);
const sc = (s: string) => Math.round(avg.mobile[s].perf ?? 0);
---
<section class="sec" id="versus">
  <div class="wrap">
    <header class="sec-head">
      <p class="kicker rv"><b>08</b> Shopify vs Magento 2</p>
      <h2 class="sec-title rv">Rent the store, or <em>own</em> it</h2>
      <p class="dek rv">Speed is only part of the choice. Here is how the two platforms differ on everything else, where each one is the better pick, and a quick way to see which fits your priorities. Facts and prices checked 16 October 2026; sources at the bottom of the page.</p>
    </header>

    <div class="card tug rv" aria-label={`Of ${total} aspects: Shopify has the edge on ${tally.shopify}, it depends on ${tally.depends}, Magento 2 has the edge on ${tally.m2}`} role="img">
      <div class="tug-labels" aria-hidden="true">
        <span data-stack="shopify"><b class="num">{tally.shopify}</b><span class="tl"><i class="glyph triangle"></i>Shopify has the edge</span></span>
        <span class="dep"><b class="num">{tally.depends}</b><span class="tl">It depends</span></span>
        <span data-stack="m2"><b class="num">{tally.m2}</b><span class="tl"><i class="glyph circle"></i>Magento 2 has the edge</span></span>
      </div>
      <div class="tug-bar" aria-hidden="true">
        <i class="tb-s" data-stack="shopify" style={`--w:${(tally.shopify / total) * 100}%`}></i>
        <i class="tb-d" style={`--w:${(tally.depends / total) * 100}%`}></i>
        <i class="tb-m" data-stack="m2" style={`--w:${(tally.m2 / total) * 100}%`}></i>
      </div>
      <p class="note tug-note">{total} aspects, scored on which platform is the better default for a typical store. “Depends” means the answer turns on the business.</p>
    </div>

    <div class="card matrix" role="table" aria-label="Shopify and Magento 2 compared, aspect by aspect">
      <div class="mx-head" role="row">
        <span role="columnheader">Aspect</span>
        <span role="columnheader"><span class="key" data-stack="shopify"><i class="glyph triangle"></i>Shopify</span></span>
        <span role="columnheader"><span class="key" data-stack="m2"><i class="glyph circle"></i>Magento 2</span></span>
        <span role="columnheader">Edge</span>
      </div>
      {ROWS.map((r, i) => (
        <div class="mx-row rv" role="row" style={`--d:${Math.min(i, 6) * 0.04}s`}>
          <div class="mx-aspect" role="rowheader"><b>{r.aspect}</b><span>{r.why}</span></div>
          <div class="mx-cell" role="cell" data-stack="shopify"><span class="mx-lab key" aria-hidden="true"><i class="glyph triangle"></i>Shopify</span><p>{r.shopify}{sup(r.src).filter(n => [1, 2, 3, 4, 5, 10].includes(n)).map(n => <a class="sup" href={`#src-${n}`} aria-label={`Source ${n}`}>{n}</a>)}</p></div>
          <div class="mx-cell" role="cell" data-stack="m2"><span class="mx-lab key" aria-hidden="true"><i class="glyph circle"></i>Magento 2</span><p>{r.m2}{sup(r.src).filter(n => [6, 7, 8, 9].includes(n)).map(n => <a class="sup" href={`#src-${n}`} aria-label={`Source ${n}`}>{n}</a>)}</p></div>
          <div class="mx-edge" role="cell">
            {r.edge === 'depends'
              ? <span class="edge e-dep"><i class="half" aria-hidden="true"></i>Depends</span>
              : <span class="edge" data-stack={r.edge}><i class={`glyph ${r.edge === 'shopify' ? 'triangle' : 'circle'}`} aria-hidden="true"></i>{edgeLabel[r.edge]}</span>}
          </div>
        </div>
      ))}
    </div>

    <div class="wins">
      <article class="card win rv" data-stack="shopify">
        <h3 class="key"><i class="glyph triangle"></i>Shopify is the better choice when…</h3>
        <ul>{WINS.shopify.map(w => <li>{w}</li>)}</ul>
      </article>
      <article class="card win rv" data-stack="m2" style="--d:.06s">
        <h3 class="key"><i class="glyph circle"></i>Magento 2 is the better choice when…</h3>
        <ul>{WINS.m2.map(w => <li>{w}</li>)}</ul>
      </article>
      <article class="card win hybrid rv" data-stack="headless" style="--d:.12s">
        <h3 class="key"><i class="glyph square"></i>Or both: go headless</h3>
        <p>Our third store keeps Magento as the engine (catalogue, cart, checkout, ownership) and puts a fast Next.js storefront in front. {journeyLine} The price: two systems to build and run, the most developer effort of the three.</p>
      </article>
    </div>

    <div class="card chooser rv" data-chooser data-pri={JSON.stringify(PRIORITIES)}>
      <div class="ch-left">
        <h3>Pick your priorities</h3>
        <p class="note">Tap everything that matters for your store. The bars show how well each of the three builds fits.</p>
        <div class="chips" role="group" aria-label="Priorities">
          {PRIORITIES.map(p => <button type="button" class="chip" data-pri={p.id} aria-pressed="false">{p.label}</button>)}
        </div>
        <button type="button" class="reset" data-ch-reset>Clear all</button>
      </div>
      <div class="ch-right">
        {(['shopify', 'm2', 'headless'] as const).map(s => (
          <div class="fit" data-stack={s}>
            <span class="key"><i class={`glyph ${STACK_META[s].shape}`}></i>{STACK_META[s].name}</span>
            <div class="fit-track"><i class="fit-bar" style="--w:0%"></i></div>
            <b class="fit-v num" data-fit={s}>–</b>
          </div>
        ))}
        <p class="ch-out" data-ch-out aria-live="polite">Pick at least one priority to see a suggestion.</p>
      </div>
    </div>

    <p class="verdict2 rv"><b>The honest verdict:</b> Shopify is the better default for most small and mid-size shops: less to run, faster to launch, a checkout that converts. Magento 2 wins when the store <em>is</em> the software: complex catalogues, several sites on one backend, a custom checkout or B2B flow, and full ownership, with a team to look after it. On speed, our tuned Magento scored {sc('m2')} on mobile against Shopify’s {sc('shopify')}, because Shopify loads its own platform scripts on every page.</p>
  </div>
</section>
<style>
  .tug { padding: 20px 22px 16px; margin-bottom: 18px; }
  .tug-labels { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 14.5px; margin-bottom: 12px; }
  .tug-labels b { font-size: 22px; font-weight: 650; margin-right: 8px; letter-spacing: -0.02em; vertical-align: -2px; }
  .tug-labels .tl { font-weight: 600; }
  .tug-labels .glyph { display: inline-block; width: 11px; height: 11px; margin-right: 6px; }
  .dep { color: var(--ink-2); font-weight: 600; }
  .tug-bar { display: flex; gap: 2px; height: 14px; }
  .tug-bar i { display: block; width: var(--w); transition: width 1.1s var(--ease); }
  .tb-s { background: var(--shopify); border-radius: 4px 0 0 4px; }
  .tb-d { background: var(--axis); }
  .tb-m { background: var(--m2); border-radius: 0 4px 4px 0; }
  .js .tug:not(.in) .tug-bar i { width: 0; }
  .js .tug:not(.in) .tb-d { width: 100%; }
  .tug-note { margin: 10px 0 0; }
  .matrix { padding: 6px 22px 8px; }
  .mx-head, .mx-row { display: grid; grid-template-columns: 200px minmax(0, 1fr) minmax(0, 1fr) 128px; gap: 22px; align-items: start; }
  .mx-head { padding: 14px 0 12px; border-bottom: 1.5px solid var(--ink); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 600; }
  .mx-head .key { text-transform: none; letter-spacing: 0; font-size: 15px; color: var(--ink); }
  .mx-row { padding: 16px 0; border-bottom: 1px solid var(--grid); }
  .mx-row:last-child { border-bottom: 0; }
  .mx-aspect b { display: block; font-size: 16px; font-weight: 650; }
  .mx-aspect span { display: block; font-size: 13px; color: var(--muted); margin-top: 3px; line-height: 1.35; }
  .mx-cell p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.55; }
  .mx-lab { display: none; }
  .sup { font-size: 10.5px; font-weight: 600; vertical-align: super; line-height: 0; margin-left: 2px; color: var(--muted); text-decoration: none; padding: 0 1px; }
  .sup:hover { color: var(--ink); text-decoration: underline; }
  .edge { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 650; padding: 6px 11px; border-radius: 999px; border: 1px solid var(--hair); background: color-mix(in srgb, var(--c, var(--axis)) 12%, var(--surface)); white-space: nowrap; }
  .edge .glyph { width: 10px; height: 10px; }
  .e-dep { --c: var(--axis); color: var(--ink-2); }
  .half { width: 10px; height: 10px; border-radius: 50%; background: linear-gradient(90deg, var(--shopify) 50%, var(--m2) 50%); }
  .wins { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; margin-top: 18px; }
  .win { padding: 20px 22px; border-top: 4px solid var(--c); }
  .win h3 { font-size: 16.5px; margin-bottom: 10px; white-space: normal; align-items: flex-start; }
  .win h3 .glyph { margin-top: 5px; }
  .win ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14.5px; color: var(--ink-2); }
  .win li { padding-left: 22px; position: relative; line-height: 1.45; }
  .win li::before { content: '✓'; position: absolute; left: 0; top: 0; font-weight: 700; color: var(--ink); }
  .win p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.55; }
  .chooser { margin-top: 18px; padding: 24px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 36px; align-items: center; }
  .chooser h3 { font: 400 32px/1.05 var(--serif); }
  .chooser .note { margin: 8px 0 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { border: 1px solid var(--hair); background: var(--surface-2); padding: 8px 13px; border-radius: 999px; font-size: 14px; font-weight: 550; cursor: pointer; color: var(--ink-2); transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s var(--ease); min-height: 38px; }
  .chip:hover { border-color: var(--ink-2); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--page); border-color: var(--ink); }
  .chip[aria-pressed='true']::before { content: '✓ '; }
  .chip:active { transform: scale(0.97); }
  .reset { margin-top: 12px; background: none; border: 0; padding: 4px 0; font-size: 13.5px; font-weight: 600; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .fit { display: grid; grid-template-columns: 112px minmax(0, 1fr) 62px; gap: 10px; align-items: center; height: 42px; }
  .fit .key { font-size: 14px; }
  .fit-track { height: 14px; background: var(--surface-2); border-radius: 0 4px 4px 0; overflow: hidden; }
  .fit-bar { display: block; height: 100%; width: var(--w); background: var(--c); border-radius: 0 4px 4px 0; transition: width 0.7s var(--ease); }
  .fit-v { text-align: right; font-size: 16px; font-weight: 650; white-space: nowrap; }
  .fit.top .fit-v::after { content: ''; display: inline-block; width: 8px; height: 8px; margin-left: 4px; border-radius: 50%; background: var(--volt); box-shadow: 0 0 0 1px var(--ink); vertical-align: 2px; }
  .ch-out { margin: 14px 0 0; font: 400 21px/1.3 var(--serif); min-height: 2.6em; }
  .verdict2 { font: 400 clamp(22px, 2.2vw, 28px)/1.35 var(--serif); max-width: 980px; margin: 34px 0 0; padding-left: 20px; border-left: 3px solid var(--volt); }
  .verdict2 b { font-weight: 400; font-style: italic; }
  @media (max-width: 1000px) {
    .wins { grid-template-columns: 1fr; }
    .chooser { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 860px) {
    .matrix { padding: 4px 16px 6px; }
    .mx-head { display: none; }
    .mx-row { grid-template-columns: minmax(0, 1fr) auto; gap: 10px 12px; }
    .mx-aspect { grid-column: 1; }
    .mx-edge { grid-column: 2; grid-row: 1; }
    .mx-cell { grid-column: 1 / -1; }
    .mx-lab { display: inline-flex; font-size: 12.5px; margin-bottom: 3px; gap: 6px; }
    .mx-lab .glyph { width: 9px; height: 9px; }
    .tug-labels { font-size: 13px; }
    .tug-labels b { font-size: 18px; }
  }
  @media (max-width: 480px) {
    .chooser { padding: 18px 16px; }
    .fit { grid-template-columns: 96px minmax(0, 1fr) 58px; }
    .tug-labels { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; font-size: 12px; line-height: 1.3; }
    .tug-labels > span { white-space: normal; display: block; }
    .tug-labels > span:nth-child(2) { text-align: center; }
    .tug-labels > span:nth-child(3) { text-align: right; }
    .tug-labels .glyph { width: 9px; height: 9px; margin-right: 4px; }
    .tug-labels b { display: block; font-size: 20px; margin: 0 0 2px; }
  }
</style>
