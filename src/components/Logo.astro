---
// Stopwatch whose face is a pickleball. Decorative next to the wordmark (aria-hidden).
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <rect x="13" y="1.5" width="6" height="3.2" rx="1.2" fill="currentColor" />
  <rect x="24.2" y="5.6" width="4" height="2.6" rx="1" transform="rotate(42 26.2 6.9)" fill="currentColor" />
  <circle cx="16" cy="18.5" r="12" fill="#d9f24f" stroke="currentColor" stroke-width="2.4" />
  <g fill="#0b0b0b" opacity=".22">
    <circle cx="10.5" cy="14.5" r="1.5" /><circle cx="21.5" cy="23.5" r="1.5" /><circle cx="10" cy="22.5" r="1.2" /><circle cx="22" cy="13.8" r="1.2" /><circle cx="16" cy="26.3" r="1.1" />
  </g>
  <path d="M16 18.5 L20.6 11.4" stroke="#0b0b0b" stroke-width="2.4" stroke-linecap="round" />
  <circle cx="16" cy="18.5" r="2.2" fill="#0b0b0b" />
</svg>
